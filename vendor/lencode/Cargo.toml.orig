[workspace]
members = ["macros", "."]
package.version = "1.2.1"

[package]
name = "lencode"
version.workspace = true
edition = "2024"
license = "MIT"
description = "A crate for encoding and decoding variable-length data using the Lencode varint encoding scheme and deduplication"
keywords = ["encoding", "decoding", "bincode", "varint", "serde"]
authors = ["sam0x17"]
repository = "https://github.com/sam0x17/lencode"
documentation = "https://docs.rs/lencode/latest/lencode/"

[dependencies]
endian-cast = "2"
generic-array = "1"
agave-geyser-plugin-interface = { version = "=4.2.0", optional = true, features = ["agave-unstable-api"] }
solana-message = { version = ">=4.2.3,<4.5.0", optional = true }
solana-transaction = { version = ">=4.1.4,<4.2.0", optional = true }
solana-transaction-status = { version = "=4.2.0", optional = true, features = ["agave-unstable-api"] }
solana-transaction-context = { version = "=4.2.0", optional = true, features = ["agave-unstable-api"] }
solana-transaction-error = { version = ">=3.3.1,<3.4.0", optional = true }
solana-instruction = { version = ">=3.4.0,<3.5.0", optional = true }
solana-hash = { version = ">=4.4.0,<4.6.0", optional = true }
solana-signature = { version = ">=3.4.1,<3.5.0", optional = true }
solana-pubkey = { version = ">=4.2.0,<4.3.0", optional = true }
solana-reward-info = { version = ">=6.2.0,<6.3.0", optional = true }
solana-account-decoder-client-types = { version = "=4.2.0", optional = true, features = ["agave-unstable-api"] }
ruint = { version = "1", default-features = false}
newt-hype = { version = "0", default-features = false }
hashbrown = "0"
ahash = { version = "0.8", default-features = false, features = ["compile-time-rng"] }
smallbox = { version = "0.8", default-features = false }
zstd-safe = { version = "7", default-features = false }

lencode-macros = { path = "macros", version = "1.2.0" }

# Serialization helpers: keep bincode only for benches/examples
bincode = { version = "2", features = ["serde"], optional = true }

[dev-dependencies]
rayon = "1"
rand = ">= 0.9"
criterion = { git = "https://github.com/sam0x17/criterion.rs", features = ["html_reports"] }
borsh = { version = ">= 1.5", features = ["derive"] }
bincode = { version = "2", features = ["serde"] }
serde = { version = "1", features = ["derive"] }
wincode = { version = "0.2.5", features = ["derive", "solana-short-vec"] }
solana-short-vec = "3"

[features]
default = []
std = ["ruint/std"]
comparison-bench = []
solana = [
    "std",
    # Agave/geyser and supporting crates
    "dep:agave-geyser-plugin-interface",
    "dep:solana-message",
    "dep:solana-transaction",
    "dep:solana-transaction-status",
    "dep:solana-transaction-context",
    "dep:solana-transaction-error",
    "dep:solana-instruction",
    "dep:solana-hash",
    "dep:solana-signature",
    "dep:solana-pubkey",
    "dep:solana-reward-info",
    "dep:solana-account-decoder-client-types",
]

[profile.test]
opt-level = 3
lto = true

[profile.dev]
opt-level = 3
lto = true

[profile.release]
opt-level = 3
lto = true

[lints.clippy]
missing_const_for_fn = "warn"

[workspace.lints.clippy]
missing_const_for_fn = "warn"

[[bench]]
name = "varint_bench"
harness = false

[[bench]]
name = "roundup"
required-features = ["std"]
harness = false

[[bench]]
name = "solana_bench"
required-features = ["std", "solana", "comparison-bench"]
harness = false

[[bench]]
name = "bytes_bench"
harness = false
required-features = ["std"]

[[bench]]
name = "diff_bench"
harness = false
required-features = ["std"]

[[bench]]
name = "codec_bench"
harness = false
required-features = ["std", "comparison-bench"]

[[bench]]
name = "io_bench"
harness = false

[[bench]]
name = "dedupe_bench"
harness = false

[[bench]]
name = "pack_bench"
harness = false

[[bench]]
name = "heuristic_bench"
harness = false
